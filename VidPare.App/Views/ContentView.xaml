<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VidPare.App.Views.ContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:VidPare.App.Views">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Empty state: drop prompt -->
        <Grid x:Name="emptyState"
              AllowDrop="True"
              DragOver="Grid_DragOver"
              Drop="Grid_Drop">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <FontIcon Glyph="&#xE8A5;"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Drop a video file here"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="or"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Button Content="Open File"
                        Click="OpenFile_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="Supports MP4, MOV, M4V"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Loading state -->
        <StackPanel x:Name="loadingState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <ProgressRing IsActive="True" Width="48" Height="48" />
            <TextBlock x:Name="loadingText"
                       Text="Loading video..."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Editor state: player + controls + timeline -->
        <Grid x:Name="editorState"
              Visibility="Collapsed"
              AllowDrop="True"
              DragOver="Grid_DragOver"
              Drop="Grid_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Video player -->
            <MediaPlayerElement x:Name="playerElement"
                                Grid.Row="0"
                                AreTransportControlsEnabled="False"
                                Stretch="Uniform"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

            <!-- Player controls -->
            <views:PlayerControlsView x:Name="playerControls"
                                      Grid.Row="1"
                                      Margin="8,4" />

            <!-- Timeline -->
            <views:TimelineView x:Name="timelineView"
                                Grid.Row="2"
                                Height="80"
                                Margin="8,0,8,4" />

            <!-- Bottom bar: file info + export button -->
            <Grid Grid.Row="3" Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="fileInfoText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12" />
                <Button x:Name="exportButton"
                        Grid.Column="1"
                        Content="Export"
                        Click="Export_Click"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VidPare.App.Views.PlayerControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="4,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Play/Pause -->
        <Button x:Name="playPauseButton"
                Grid.Column="0"
                Click="PlayPause_Click"
                Width="36" Height="36"
                Padding="0"
                VerticalAlignment="Center">
            <FontIcon x:Name="playPauseIcon" Glyph="&#xE768;" FontSize="16" />
        </Button>

        <!-- Current time / Duration -->
        <TextBlock x:Name="timeDisplay"
                   Grid.Column="1"
                   Text="00:00 / 00:00"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   FontSize="13"
                   FontFamily="Consolas" />

        <!-- Spacer -->
        <Border Grid.Column="2" />

        <!-- Set In Point -->
        <Button x:Name="setInButton"
                Grid.Column="3"
                Click="SetIn_Click"
                ToolTipService.ToolTip="Set trim start to current position"
                Width="36" Height="36"
                Padding="0"
                Margin="4,0"
                VerticalAlignment="Center">
            <FontIcon Glyph="&#xE892;" FontSize="14" />
        </Button>

        <!-- Set Out Point -->
        <Button x:Name="setOutButton"
                Grid.Column="4"
                Click="SetOut_Click"
                ToolTipService.ToolTip="Set trim end to current position"
                Width="36" Height="36"
                Padding="0"
                Margin="0,0,4,0"
                VerticalAlignment="Center">
            <FontIcon Glyph="&#xE893;" FontSize="14" />
        </Button>

        <!-- Trim duration -->
        <TextBlock x:Name="trimDurationText"
                   Grid.Column="5"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="8,0,0,0" />
    </Grid>
</UserControl>
